# qtc-aac defaults for apps/web/.env (copied on first `make setup`; also the
# runtime defaults inside the Docker image).
DATABASE_URL="mysql://crystal:crystal@127.0.0.1:3306/crystalserver"

PUBLIC_BASE_URL="http://127.0.0.1:5173"

PUBLIC_TITLE="qtc-aac"
PUBLIC_DISCORD_URL=""
PUBLIC_YOUTUBE_URL=""
PUBLIC_WHATSAPP_URL=""
PUBLIC_INSTAGRAM_URL=""
PUBLIC_WIKI_URL=""
PUBLIC_DOWNLOAD_URL="/download"
# Coin webshop (CIP payments.cipsoft.com). Optional, served by a product pack.
PUBLIC_PAYMENTS_URL=""
PUBLIC_SUPPORT_EMAIL="admin@localhost"

PUBLIC_ENABLE_PRONOUNS=false

SERVER_ADDRESS="127.0.0.1"
# CipSoft's game port: 7171 for both game connections (gameProtocolPort and
# gameProtocolPortUnprotected in config.lua).
SERVER_PORT=7171
SERVER_PORT_UNPROTECTED=7171
# The second endpoint's host (CipSoft login: externaladdressunprotected). CipSoft
# serves both endpoints on one port under two host names; the client opens its
# secondary connection only when the endpoints differ. Used for this server's
# own host (QTCAAC_GAME_WS_HOST / SERVER_ADDRESS / loopback); a loopback name
# is never advertised for a public host. Empty = one connection.
SERVER_ADDRESS_UNPROTECTED="localhost"
# TCP probe for /api/online-status: Crystal's status port (worlds.port_status),
# never the game port. STATUS_ADDRESS defaults to SERVER_ADDRESS.
STATUS_PORT=7173
# STATUS_ADDRESS=
SERVER_NAME="Server"
SERVER_LOCATION="Local"

PVP_TYPE="no-pvp"

# Browser /play: Crystal native game WebSocket (must match websocketGamePort
# in config.lua). Default 7174 — worlds.port_status=7173 is ProtocolStatus.
QTCAAC_CRYSTAL_WEBSOCKET_PORT=7174
# Browser secondary connection (websocketGamePortUnprotected; 0 = none), on
# SERVER_ADDRESS_UNPROTECTED's host.
QTCAAC_CRYSTAL_WEBSOCKET_PORT_UNPROTECTED=7176
# Production HTTPS play: TLS proxy host in front of the game WebSocket; the
# secondary goes to SERVER_ADDRESS_UNPROTECTED on the same TLS port (the proxy
# routes that host to websocketGamePortUnprotected).
# QTCAAC_GAME_WS_HOST=game.example.com
# QTCAAC_CRYSTAL_WEBSOCKET_PORT=443
# SERVER_ADDRESS_UNPROTECTED=game-lb.example.com
# QTCAAC_CRYSTAL_WEBSOCKET_PORT_UNPROTECTED=443

# qtclient CDN tip (CIP layout, like static.tibia.com). /play loads the WASM
# engine + packs from here; outfits/items/store images come from its asset
# slices. Local: `make -C ../qtclient local-cdn` (or any static server).
QTCAAC_ASSET_BASE=http://127.0.0.1:9080
# Without a qtclient tip, point sprites at MyAAC-style image hosts instead:
# QTCAAC_ITEM_IMAGES_URL=https://item-images.example/latest/
# QTCAAC_ITEM_IMAGES_EXT=.gif
# QTCAAC_OUTFIT_IMAGES_URL=https://outfit-images.example/outfit.php

# Reject logins from clients older than the live release (latest/release.json).
# QTCAAC_REQUIRE_CLIENT_REVISION=1

# Create-account + bottom-menu showoff (optional overrides)
# CREATE_ACCOUNT_ENABLED=true
# QTCAAC_SHOWOFF_IMAGE=
# QTCAAC_SHOWOFF_TITLE=
# QTCAAC_SHOWOFF_DESCRIPTION=

# Client telemetry (crash reports, FPS history, system surveys)
# QTCAAC_TELEMETRY_ENABLED=true
# QTCAAC_TELEMETRY_DIR=data/telemetry
# QTCAAC_TELEMETRY_RETENTION_DAYS=90
# QTCAAC_TELEMETRY_SALT=change-me
# QTCAAC_CRASH_MAX_BYTES=33554432
# adapter-node request body cap (production). Minidumps/.sym uploads need more
# than the 512K default; the image sets 600M.
# BODY_SIZE_LIMIT=600M
# CI symbol upload (POST /api/telemetry/symbols, Bearer token). Empty = disabled.
# QTCAAC_SYMBOL_UPLOAD_TOKEN=
# QTCAAC_MINIDUMP_STACKWALK=minidump-stackwalk

PUBLIC_STRIPE_KEY=
SECRET_STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

ENABLE_STRIPE_CUSTOM=false
ENABLE_STRIPE_CHECKOUT=false

NO_REPLY_EMAIL="no-reply <no-reply@localhost>"
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_BACKGROUND_COLOR="#eee6d9"
EMAIL_BUTTON_COLOR="#0010cd"
EMAIL_BUTTON_TEXT="#f4ca41"

AUTO_ADMIN_EMAIL="admin@localhost"
REQUIRE_EMAIL_CONFIRMATION_TO_LOGIN=false

# Crystal schema uses SHA1 passwords + email\npassword session keys
ALLOW_LEGACY_SHA1_PASSWORDS=true
DEPRECATED_USE_SHA1_PASSWORDS=true

# Event calendar (Crystal events.json shape → clientservices eventschedule).
# Default: content/events.json (a pack's content/pack/events.json wins).
# QTCAAC_EVENTS_JSON=

GAME_SESSION_EXPIRATION_TIME=24h

MINIMOUM_GUILD_LEVEL=8

FREE_PREMIUM=true
PUBLIC_TUTORIAL_ENABLED=true
SERVER_SAVE_TIME=00:00:00

# Char Bazaar bidding (transferable coins). Auctions are set up in the game
# client; listing fee, duration and tax come from the game server's
# charBazaar* settings and are stored on each auction.
BAZAAR_BID_FEE_COINS=50

# Referral (transferable coins when the invitee reaches the level gate)
REFERRAL_MIN_LEVEL=50
REFERRAL_REWARD_COINS=5

# PIX via Stripe PaymentIntent payment_method_types=['pix'] (requires Stripe PIX enabled)
ENABLE_PIX=false
