{
	"name": "qtc-aac",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @qtc-aac/web dev",
		"build": "bun run --filter @qtc-aac/web build",
